APCA_API_KEY_ID=your_key_id
APCA_API_SECRET_KEY=your_secret_key
APCA_API_BASE_URL=https://paper-api.alpaca.markets

# Static mode: trades exactly this list, nothing else.
WATCHLIST=AAPL,MSFT,NVDA,AMZN,GOOGL,META,TSLA,SPY,QQQ

# UNIVERSE_MODE left unset (or "static") means WATCHLIST above is what gets
# traded. Set to "dynamic" to instead rank ~12,000 tradable US stocks by
# liquidity once a day and trade the top UNIVERSE_SIZE of them -- see
# .env.dynamic.example for that mode's template.
UNIVERSE_MODE=static
UNIVERSE_SIZE=50

# Bar resolution the strategy trades on: "minute", "hourly" (faster, more
# trades), or "daily" (swing)
STRATEGY_TIMEFRAME=hourly

# How often the live loop re-evaluates signals. Leave unset to auto-pick a
# sensible default for STRATEGY_TIMEFRAME (30s for minute, 15m for hourly/
# daily) -- an explicit value here always wins over that default, at any
# timeframe. Can never go below the rate-limit safety floor for MAX_POSITIONS
# (config.Load raises it automatically if you set it lower).
# POLL_INTERVAL=15m

# Risk management
# RISK_PER_TRADE_PCT is the real sizing driver: % of equity lost if the
# ATR-based stop is hit. Position size scales with the stop distance on its
# own (tighter stop = bigger size, wider stop = smaller) -- it is NOT a fixed
# % of equity per trade.
RISK_PER_TRADE_PCT=1.0
# MAX_POSITION_PCT is a backstop, not a target: it only catches degenerate
# cases (e.g. a near-zero ATR blowing the risk math up to an absurd share
# count). Left high so it doesn't routinely override the risk calculation.
MAX_POSITION_PCT=100.0
MAX_POSITIONS=5
DAILY_LOSS_LIMIT_PCT=3.0

# Early exit / rotation: off by default, since unlike the rest of the exit
# logic it hasn't been backtested. If enabled and every MAX_POSITIONS slot
# is full (or the top candidate can't be sized, e.g. not enough buying
# power), closes the weakest held position for a clearly stronger candidate
# instead of only ever exiting via stop/take. ROTATION_MARGIN is how much
# stronger (in Signal.TrendStrength) a candidate must be to justify the
# swap -- keep it meaningful so it doesn't swap on noise.
ENABLE_ROTATION=false
ROTATION_MARGIN=0.01
