APCA_API_KEY_ID=your_key_id
APCA_API_SECRET_KEY=your_secret_key
APCA_API_BASE_URL=https://paper-api.alpaca.markets

# Comma-separated list of symbols to trade
WATCHLIST=AAPL,MSFT,NVDA,AMZN,GOOGL,META,TSLA,SPY,QQQ

# Bar resolution the strategy trades on: "minute", "hourly" (faster, more
# trades), or "daily" (swing)
STRATEGY_TIMEFRAME=hourly

# How often the live loop re-evaluates signals. Leave unset to auto-pick a
# sensible default for STRATEGY_TIMEFRAME (30s for minute, 15m for hourly/
# daily) -- an explicit value here always wins over that default, at any
# timeframe.
POLL_INTERVAL=15m

# Risk management
# RISK_PER_TRADE_PCT is the real sizing driver: % of equity lost if the
# ATR-based stop is hit. Position size scales with the stop distance on its
# own (tighter stop = bigger size, wider stop = smaller) -- it is NOT a fixed
# % of equity per trade.
RISK_PER_TRADE_PCT=1.0
# MAX_POSITION_PCT is a backstop, not a target: it only catches degenerate
# cases (e.g. a near-zero ATR blowing the risk math up to an absurd share
# count). Left high so it doesn't routinely override the risk calculation.
MAX_POSITION_PCT=100.0
MAX_POSITIONS=5
DAILY_LOSS_LIMIT_PCT=3.0
