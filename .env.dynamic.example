APCA_API_KEY_ID=your_key_id
APCA_API_SECRET_KEY=your_secret_key
APCA_API_BASE_URL=https://paper-api.alpaca.markets

# Ignored in dynamic mode (still used by `backtest`, which doesn't support
# dynamic mode) -- kept here so switching back to static is a one-line change.
#WATCHLIST=AAPL,MSFT,NVDA,AMZN,GOOGL,META,TSLA,SPY,QQQ

# Dynamic mode: instead of a fixed WATCHLIST, once per calendar day rank
# (almost) every tradable US stock by liquidity (average dollar volume) and
# trade the top UNIVERSE_SIZE of them for the rest of that day. Takes ~1-2
# minutes on the first tick of each day (scans ~12,000 symbols via batched
# requests); cached afterward. See README "Which symbols it trades" for the
# full rationale, and "Staying inside Alpaca's rate limit" for how polling
# frequency and universe size interact -- the engine automatically scans as
# many candidates as safely fit each tick and rotates through the rest if
# UNIVERSE_SIZE and POLL_INTERVAL together would exceed the rate limit.
UNIVERSE_MODE=dynamic
UNIVERSE_SIZE=50

# Bar resolution the strategy trades on: "minute", "hourly" (faster, more
# trades), or "daily" (swing)
STRATEGY_TIMEFRAME=hourly

# How often the live loop re-evaluates signals. Leave unset to auto-pick a
# sensible default for STRATEGY_TIMEFRAME (30s for minute, 15m for hourly/
# daily) -- an explicit value here always wins over that default, at any
# timeframe. Can never go below the rate-limit safety floor for MAX_POSITIONS
# (config.Load raises it automatically if you set it lower). With a larger
# UNIVERSE_SIZE, a faster POLL_INTERVAL means more candidates get deferred to
# later ticks rather than scanned immediately -- see the rate-limit section
# in the README before shrinking this much below the default.
POLL_INTERVAL=15m

# Risk management
# RISK_PER_TRADE_PCT is the real sizing driver: % of equity lost if the
# ATR-based stop is hit. Position size scales with the stop distance on its
# own (tighter stop = bigger size, wider stop = smaller) -- it is NOT a fixed
# % of equity per trade.
RISK_PER_TRADE_PCT=1.0
# MAX_POSITION_PCT is a backstop, not a target: it only catches degenerate
# cases (e.g. a near-zero ATR blowing the risk math up to an absurd share
# count). Left high so it doesn't routinely override the risk calculation.
MAX_POSITION_PCT=100.0
MAX_POSITIONS=5
DAILY_LOSS_LIMIT_PCT=3.0
